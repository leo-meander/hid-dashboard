# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Cloudbeds
CLOUDBEDS_API_KEY=your_cloudbeds_api_key
# Comma-separated JSON: [{"branch_id": "uuid", "property_id": "123"}]
CLOUDBEDS_PROPERTY_IDS=[{"branch_id":"<uuid>","property_id":"<cloudbeds_id>"}]

# Exchange Rate API (https://www.exchangerate-api.com)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_RECIPIENTS=user1@example.com,user2@example.com

# Ads Platform API (Meander internal — replaces Meta Graph API + Google Sheets ads)
# Auth via X-API-Key header. Rate limit: 1000 req/day/key.
ADS_PLATFORM_BASE_URL=https://ads-performance-fuls.zeabur.app
ADS_PLATFORM_API_KEY=your_ads_platform_api_key

# Google OAuth (used by KOL sheet sync + GHL email sync — NOT for ads anymore)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Google Ads offline conversions — Data Manager API.
# Separate refresh token: needs scope https://www.googleapis.com/auth/datamanager,
# which GOOGLE_REFRESH_TOKEN above does not carry. Leave empty to skip uploads.
GOOGLE_DATAMANAGER_REFRESH_TOKEN=
# Optional: dedicated OAuth client for Data Manager. Leave empty to reuse
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
GOOGLE_DATAMANAGER_CLIENT_ID=
GOOGLE_DATAMANAGER_CLIENT_SECRET=
GOOGLE_LOGIN_CUSTOMER_ID=your_mcc_customer_id

# GA4 Data API — powers Website Purchase Conversion Rate on the Paid Ads tab.
# The service account email must be granted Viewer on every property below, or
# runReport returns 403 and the KPI renders blank.
#
# On Zeabur set the _B64 one: the key file's private_key contains literal
# newlines that the env-var text box does not preserve, so raw JSON arrives
# corrupted. Build it with:  base64 -w 0 your-service-account.json
GA4_SERVICE_ACCOUNT_JSON_B64=
# Raw JSON fallback, fine in a local .env where newlines survive. The _B64 one
# wins if both are set; either accepts either format.
GA4_SERVICE_ACCOUNT_JSON=
# Property IDs default to the live ones in config.py; override only per env.
GA4_PROPERTY_ID_SAIGON=
GA4_PROPERTY_ID_1948=
GA4_PROPERTY_ID_TAIPEI=
GA4_PROPERTY_ID_OSAKA=
# Oani's tag was removed from the 1948 and Osaka sites on 2026-08-09; its
# pre-September history stays polluted, which purchase_cvr handles per branch.
GA4_PROPERTY_ID_OANI=

# PageSpeed Insights — powers Avg Website Load Speed on the Paid Ads tab.
# Optional: works keyless at this volume (5 branches, once a month), a key
# just lifts the quota. Get one at
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
# Branch URLs default to the live ones in config.py; override only per env.
PAGESPEED_URL_SAIGON=
PAGESPEED_URL_1948=
PAGESPEED_URL_TAIPEI=
PAGESPEED_URL_OSAKA=
PAGESPEED_URL_OANI=

# KOL Media Engine
KOL_ENGINE_URL=https://kol-media-engine.zeabur.app
KOL_ENGINE_ORG_ID=your_org_id
KOL_SYNC_API_KEY=your_kol_sync_api_key
# Bearer token for KOL Engine public revenue endpoint
# (GET /api/public/kol-revenue/{org_slug}). De-duped against Ads Platform
# attribution from 2026-05-01 onward. Powers Marketing Activity KOL row.
KOL_REVENUE_API_SECRET=your_kol_revenue_api_secret

# App
APP_ENV=development
SECRET_KEY=changeme_use_a_long_random_string
FRONTEND_URL=https://your-zeabur-domain.zeabur.app

# Shared secret for GitHub Actions cron workflows (required header X-Sync-Token).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable the check (dev only — never empty in production).
SYNC_TRIGGER_TOKEN=changeme_random_secret
